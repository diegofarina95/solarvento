# Configuración de SolarVento (backend). Copia a backend/.env y ajusta.

# Precio de la electricidad por defecto (€/kWh) si el usuario no indica otro
SOLVENTO_ELECTRICITY_PRICE_EUR_KWH=0.15

# Potencia por panel por defecto (W)
SOLVENTO_PANEL_POWER_W=450

# TTL de la caché de respuestas PVGIS en segundos (default: 90 días)
SOLVENTO_CACHE_TTL_SECONDS=7776000

# Ruta del fichero SQLite de caché
SOLVENTO_CACHE_DB_PATH=pvgis_cache.db

# User-Agent para PVGIS y Nominatim (identifícate: es requisito de Nominatim)
SOLVENTO_HTTP_USER_AGENT=SolarVento/0.1 (solar calculator; diego.farina@gimo.co.uk)

# Parser IA opcional de facturas PDF/imagen. Si no se define, se usa el
# extractor local (solo PDF; las fotos requieren IA).
SOLVENTO_OPENAI_API_KEY=
# También se acepta OPENAI_API_KEY si ya usas la variable estándar de OpenAI.
SOLVENTO_OPENAI_BILL_PARSER_MODEL=gpt-5.5
SOLVENTO_OPENAI_BILL_PARSER_TIMEOUT_SECONDS=60

# Límite de subidas de factura por IP (cada una es una llamada de pago a OpenAI)
SOLVENTO_UPLOAD_RATELIMIT_MAX=10
SOLVENTO_UPLOAD_RATELIMIT_WINDOW_SECONDS=86400
SOLVENTO_UPLOAD_RATELIMIT_DB_PATH=upload_ratelimit.db
# Tope global diario de subidas (todas las IPs juntas)
SOLVENTO_UPLOAD_RATELIMIT_GLOBAL_MAX=100
# Límite de cálculos por equipo y global diario (protege el cupo de PVGIS)
SOLVENTO_ESTIMATE_RATELIMIT_MAX=60
SOLVENTO_ESTIMATE_RATELIMIT_GLOBAL_MAX=1000
